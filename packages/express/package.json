{
  "name": "@pakpay-js/express",
  "version": "1.1.0",
  "description": "Express middleware for pakpay-js payment callbacks",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["pakpay", "express", "easypaisa", "jazzcash", "pakistan"],
  "author": "Evolvo <dev@evolvo.pk>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evolvo/pakpay-js.git",
    "directory": "packages/express"
  },
  "peerDependencies": {
    "express": ">=4.18.0",
    "pakpay-js": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "express": "^4.21.2",
    "pakpay-js": "file:../..",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
